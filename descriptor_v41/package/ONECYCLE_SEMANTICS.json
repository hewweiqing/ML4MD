{
  "schema_version": 1,
  "scheduler": "torch.optim.lr_scheduler.OneCycleLR",
  "max_lr": 0.001,
  "epochs": 40,
  "steps_per_epoch": "len(training_loader)",
  "pct_start": 0.3,
  "anneal_strategy": "cos",
  "cycle_momentum": true,
  "div_factor": 25,
  "final_div_factor": 10000,
  "step_timing": "exactly once immediately after every optimizer.step()",
  "gradient_accumulation": false,
  "optimizer_recreated_per_branch_after_rng_reset": true,
  "scheduler_recreated_per_branch_after_rng_reset": true,
  "initial_learning_rate": 0.00004,
  "nominal_final_learning_rate": 4e-9
}
